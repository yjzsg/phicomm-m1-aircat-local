[Unit]
Description=M1 fake cloud network (redirect device traffic to local HTTPS service)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# 按你的网络改这几个值
Environment=M1_IP=192.168.123.54
Environment=LOCAL_IP=192.168.123.6
Environment=IFACE_NAME=enxc84d44294124
Environment=FAKE_CLOUD_PORT=9443

ExecStart=/usr/local/bin/m1-fake-cloud-net.sh up
ExecStop=/usr/local/bin/m1-fake-cloud-net.sh down

[Install]
WantedBy=multi-user.target
